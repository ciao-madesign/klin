{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "lookalike@klin",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "bookmarks",
    "history",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "detect.js",
      "background.js"
    ]
  }
}
