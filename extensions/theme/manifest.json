{
  "manifest_version": 3,
  "name": "Klin",
  "version": "0.1.0",
  "description": "Klin's look for the browser: dark, one lime accent (docs/STYLE.md).",
  "browser_specific_settings": { "gecko": { "id": "theme@klin", "strict_min_version": "128.0" } },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "theme": {
    "colors": {
      "frame": "#0a0a0a",
      "frame_inactive": "#0a0a0a",
      "tab_background_text": "#a8a8a2",
      "tab_text": "#f1f1ec",
      "tab_selected": "#141414",
      "tab_line": "#d4ff2a",
      "toolbar": "#141414",
      "toolbar_text": "#f1f1ec",
      "bookmark_text": "#f1f1ec",
      "toolbar_field": "#0a0a0a",
      "toolbar_field_text": "#f1f1ec",
      "toolbar_field_border": "#3a3a3a",
      "toolbar_field_focus": "#0a0a0a",
      "toolbar_field_border_focus": "#d4ff2a",
      "toolbar_field_highlight": "#d4ff2a",
      "toolbar_field_highlight_text": "#0a0a0a",
      "toolbar_top_separator": "#222222",
      "toolbar_bottom_separator": "#222222",
      "toolbar_vertical_separator": "#222222",
      "icons": "#f1f1ec",
      "icons_attention": "#d4ff2a",
      "button_background_hover": "#222222",
      "button_background_active": "#3a3a3a",
      "popup": "#141414",
      "popup_text": "#f1f1ec",
      "popup_border": "#3a3a3a",
      "popup_highlight": "#d4ff2a",
      "popup_highlight_text": "#0a0a0a",
      "sidebar": "#141414",
      "sidebar_text": "#f1f1ec",
      "sidebar_border": "#222222",
      "sidebar_highlight": "#d4ff2a",
      "sidebar_highlight_text": "#0a0a0a",
      "ntp_background": "#0a0a0a",
      "ntp_text": "#f1f1ec",
      "tab_loading": "#d4ff2a",
      "focus_outline": "#d4ff2a"
    }
  }
}
